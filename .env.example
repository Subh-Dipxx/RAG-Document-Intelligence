# ==============================================================================
# RAG Document Intelligence Platform - Environment Configuration
# ==============================================================================

# PostgreSQL & pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/rag

# Redis (Caching & Celery Broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Task Queue
CELERY_DEFAULT_QUEUE=default
CELERY_DOCUMENT_QUEUE=document_tasks
CELERY_DEAD_LETTER_QUEUE=dead_letter
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX=60

# MinIO / AWS S3 Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_PORT=9000
MINIO_BROWSER_PORT=9001
MINIO_BUCKET_RAW_DOCUMENTS=raw-documents
MINIO_BUCKET_PAGE_IMAGES=page-images
MINIO_BUCKET_OCR_OUTPUT=ocr-output
MINIO_BUCKET_TABLES=extracted-tables
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_BUCKET_PROFILE_PICTURES=profile-pictures
MINIO_PRESIGN_EXPIRES_SECONDS=3600
OBJECT_STORAGE_BACKEND=minio

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# OpenSearch (Hybrid / Lexical Search)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_MONITORING_PORT=9600
OPENSEARCH_URL=http://opensearch:9200

# Backend API & Frontend Ports
API_HOST=api
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Google Gemini LLM API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-1.5-pro
GEMINI_TEMPERATURE=0.2

# Chunking & Embedding Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNKER_TYPE=structure_aware
SEMANTIC_SIMILARITY_THRESHOLD=0.75
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Retrieval Settings
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.6

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (Gmail / Custom SMTP)
# Used for Password Reset and MCP Email Tool
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com

# MCP (Model Context Protocol) Microservices
MCP_SERVER_URL=http://mcp-email:8000/mcp
MCP_CHART_SERVER_URL=http://mcp-chart:8000/mcp
