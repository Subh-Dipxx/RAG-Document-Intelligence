# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/rag

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_DEFAULT_QUEUE=default
CELERY_DOCUMENT_QUEUE=document_tasks
CELERY_DEAD_LETTER_QUEUE=dead_letter
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX=60

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_BROWSER_PORT=9001

MINIO_BUCKET_RAW_DOCUMENTS=raw-documents
MINIO_BUCKET_PAGE_IMAGES=page-images
MINIO_BUCKET_OCR_OUTPUT=ocr-output
MINIO_BUCKET_TABLES=extracted-tables
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_PRESIGN_EXPIRES_SECONDS=3600

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_MONITORING_PORT=9600
OPENSEARCH_URL=http://opensearch:9200

# API
API_HOST=api
API_PORT=8000
# Frontend
FRONTEND_PORT=3000
